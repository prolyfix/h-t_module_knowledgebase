{% extends '@!EasyAdmin/page/content.html.twig' %}
{% block main %}
	<div
		class="container-fluid">
		<!-- start page title -->
		<div class="row">
			<div class="col-12">
				<div class="page-title-box">
					<h4 class="page-title">{{entity.instance.name}}</h4>
                    {# Todo: intégrer les boutons d'easy admin.#}
					<div class="page-title-right">


					</div>
				</div>
			</div>
		</div>
		<!-- end page title -->
		<div class="row">
			<div class="col-lg-12">
				<div class="card">
					<div class="card-body" data-controller="order">
                        {{entity.instance.description |raw}}
						<div class="mt-3">
							{% include '@ProlyfixHolidayAndTime/common/reads_stats.html.twig' with {'readsStats': knowledgebaseReadsStats|default([])} %}
						</div>
					</div>
				</div>
			</div>
		</div>
		<!-- end row -->

	</div>
{% endblock %}
